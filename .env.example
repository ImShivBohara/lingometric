# ==============================================================================
# LingoMetric Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or expose production secrets to Git.
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (Server-side ONLY)
# Used exclusively in secure server actions for grading RPCs and administrative mutations.
# NEVER expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Google Gemini API Configuration
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional: Gemini Model selection (defaults to gemini-2.5-flash)
# Supported fallbacks: gemini-2.5-flash, gemini-flash-latest, gemini-2.0-flash
GEMINI_MODEL=gemini-3.8-flash
